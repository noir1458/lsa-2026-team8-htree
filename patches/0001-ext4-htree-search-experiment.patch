+/* Experimental lookup policy. This does not change the on-disk format. */
+static unsigned int htree_search;
+static unsigned int htree_linear_limit = 8;
+static bool htree_profile;
+
+enum htree_counter {
+	HT_FIND, HT_DX_LOOKUP, HT_PROBE, HT_NODE, HT_COUNT_SUM,
+	HT_BINARY, HT_LINEAR, HT_COMPARE, HT_LEAF_BLOCK, HT_LEAF_ENTRY,
+	HT_LEAF_ERROR, HT_MISMATCH, HT_COUNTERS
+};
+static atomic64_t htree_counters[HT_COUNTERS] = {
+	[0 ... HT_COUNTERS - 1] = ATOMIC64_INIT(0)
+};
+static atomic64_t htree_hist[11] = {
+	[0 ... 10] = ATOMIC64_INIT(0)
+};
+
+static bool htree_profile_task(void)
+{
+	return unlikely(READ_ONCE(htree_profile)) &&
+		!strcmp(current->comm, "lookup_bench");
+}
+
+static int htree_search_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned int mode;
+	int err = kstrtouint(val, 0, &mode);
+
+	if (err)
+		return err;
+	if (mode > 2)
+		return -EINVAL;
+	WRITE_ONCE(*(unsigned int *)kp->arg, mode);
+	return 0;
+}
+
+static const struct kernel_param_ops htree_search_ops = {
+	.set = htree_search_set,
+	.get = param_get_uint,
+};
+module_param_cb(htree_search, &htree_search_ops, &htree_search, 0644);
+MODULE_PARM_DESC(htree_search, "HTree search: 0=binary, 1=linear, 2=hybrid");
+module_param_named(htree_linear_limit, htree_linear_limit, uint, 0644);
+MODULE_PARM_DESC(htree_linear_limit, "Hybrid uses linear search when count <= limit");
+module_param_named(htree_profile, htree_profile, bool, 0644);
+MODULE_PARM_DESC(htree_profile, "Profile only tasks named lookup_bench; disable for timing");
+
+static int htree_stats_get(char *buf, const struct kernel_param *kp)
+{
+	static const char * const names[HT_COUNTERS] = {
+		"find", "dx_lookup", "probe", "nodes", "count_sum",
+		"binary_nodes", "linear_nodes", "comparisons", "leaf_blocks",
+		"leaf_entries", "leaf_errors", "mismatches"
+	};
+	static const char * const buckets[11] = {
+		"count_1", "count_2", "count_3_4", "count_5_8",
+		"count_9_16", "count_17_32", "count_33_64",
+		"count_65_128", "count_129_256", "count_257_512",
+		"count_513_plus"
+	};
+	int i, len = 0;
+
+	for (i = 0; i < HT_COUNTERS; i++)
+		len += scnprintf(buf + len, PAGE_SIZE - len, "%s=%lld ",
+				 names[i], (long long)atomic64_read(&htree_counters[i]));
+	for (i = 0; i < ARRAY_SIZE(htree_hist); i++)
+		len += scnprintf(buf + len, PAGE_SIZE - len, "%s=%lld%s",
+				 buckets[i], (long long)atomic64_read(&htree_hist[i]),
+				 i == ARRAY_SIZE(htree_hist) - 1 ? "\n" : " ");
+	return len;
+}
+
+static int htree_reset_set(const char *val, const struct kernel_param *kp)
+{
+	bool reset;
+	int i, err = kstrtobool(val, &reset);
+
+	if (err)
+		return err;
+	/* Stop profiling and the benchmark before resetting or reading totals. */
+	if (READ_ONCE(htree_profile))
+		return -EBUSY;
+	if (!reset)
+		return -EINVAL;
+	for (i = 0; i < HT_COUNTERS; i++)
+		atomic64_set(&htree_counters[i], 0);
+	for (i = 0; i < ARRAY_SIZE(htree_hist); i++)
+		atomic64_set(&htree_hist[i], 0);
+	return 0;
+}
+
+static const struct kernel_param_ops htree_stats_ops = {
+	.get = htree_stats_get,
+};
+static const struct kernel_param_ops htree_reset_ops = {
+	.set = htree_reset_set,
+};
+module_param_cb(htree_stats, &htree_stats_ops, NULL, 0444);
+module_param_cb(htree_reset, &htree_reset_ops, NULL, 0200);
 
