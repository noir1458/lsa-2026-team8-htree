  * check for this error code, and make sure it never gets reflected
  * back to userspace.
  */
+/* entry 0 is the sentinel; never interpret its count/limit as a hash. */
+static inline struct dx_entry *
+htree_binary_search(struct dx_entry *entries, unsigned int count, u32 hash)
+{
+	struct dx_entry *p = entries + 1, *q = entries + count - 1, *m;
+
+	while (p <= q) {
+		m = p + (q - p) / 2;
+		if (dx_get_hash(m) > hash)
+			q = m - 1;
+		else
+			p = m + 1;
+	}
+	return p - 1;
+}
+
+static inline struct dx_entry *
+htree_linear_search(struct dx_entry *entries, unsigned int count, u32 hash)
+{
+	struct dx_entry *p = entries + 1, *end = entries + count;
+
+	while (p < end && dx_get_hash(p) <= hash)
+		p++;
+	return p - 1;
+}
+
+/*
+ * Profiling is a separate replay, never part of a timing run. The real
+ * searches above contain no per-comparison instrumentation. Verify the
+ * selected entry against the original binary-search result on real nodes.
+ */
+static void htree_record_node(struct dx_entry *entries, unsigned int count,
+			      u32 hash, bool linear, struct dx_entry *selected)
+{
+	struct dx_entry *p = entries + 1, *q = entries + count - 1, *m;
+	unsigned int comparisons = 0;
+	unsigned int bucket = min_t(unsigned int, fls(count - 1), 10);
+
+	if (linear) {
+		while (p < entries + count) {
+			comparisons++;
+			if (dx_get_hash(p) > hash)
+				break;
+			p++;
+		}
+	} else {
+		while (p <= q) {
+			comparisons++;
+			m = p + (q - p) / 2;
+			if (dx_get_hash(m) > hash)
+				q = m - 1;
+			else
+				p = m + 1;
+		}
+	}
+	atomic64_inc(&htree_counters[HT_NODE]);
+	atomic64_add(count, &htree_counters[HT_COUNT_SUM]);
+	atomic64_inc(&htree_counters[linear ? HT_LINEAR : HT_BINARY]);
+	atomic64_add(comparisons, &htree_counters[HT_COMPARE]);
+	atomic64_inc(&htree_hist[bucket]);
+	if (selected != htree_binary_search(entries, count, hash))
+		atomic64_inc(&htree_counters[HT_MISMATCH]);
+}
